# Environment
DATABASE_URL=postgresql+asyncpg://mce:mce_secret@localhost:5432/mce_forensics
SYNC_DATABASE_URL=postgresql+psycopg2://mce:mce_secret@localhost:5432/mce_forensics
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=FalconDataRescue Forensic Recovery
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Storage
EVIDENCE_MOUNT_PATH=/evidence
RECOVERY_OUTPUT_PATH=/output
MAX_UPLOAD_SIZE_MB=10240

# ML
ML_MODEL_PATH=/models
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
AI_VISUAL_ENABLED=true
AI_VISUAL_MODEL=facebook/dinov2-small
AI_ALLOW_MODEL_DOWNLOAD=false
AI_REFERENCE_DIR=

# LLM / AI Providers
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Hugging Face Inference API
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# PostgreSQL (for docker-compose)
POSTGRES_USER=mce
POSTGRES_PASSWORD=mce_secret
POSTGRES_DB=mce_forensics

# Redis
REDIS_PASSWORD=
